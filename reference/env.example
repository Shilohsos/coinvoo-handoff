# Coinvoo — environment variables
#
# Placeholders only. Real values live in the service .env on the host and are
# never committed. Copy to /srv/coinvoo/.env and fill in.

# --- service ---
PORT=8770
DB_PATH=/srv/coinvoo/coinvoo.db
PUBLIC_BASE=https://CHANGEME_YOUR_DOMAIN
TZ=Africa/Lagos
DEFAULT_BRAND=brand-one
# postbacks per second per IP before 429 (docs/05 §9); 0 switches the limit off
AFF_RATE_LIMIT_PER_SEC=100
# GET /go/<brand> visits per second per IP before 429 (phase 9); 0 switches the limit off
GO_RATE_PER_SEC=20
# postback key (phase 10): the affiliate network must send ?key=AFF_KEY; 16+ chars (openssl rand -hex 24).
# Unset = every postback accepted (the old behaviour). AFF_KEY_ENFORCE=0 = check and count only (rollout, docs/07 §4a)
AFF_KEY=CHANGEME_LONG_RANDOM_POSTBACK_KEY
AFF_KEY_ENFORCE=1
# days to keep the raw client IP on a click for Meta matching (phase 10); 0 keeps it forever
IP_RAW_RETENTION_DAYS=90

# --- ad links -> per-click channel invites (phase 12, docs/10) ---
# the gate bot's local invite server and the secret both sides share (16+ characters); unset = no per-click invites
GATE_BOT_API=http://127.0.0.1:8771
GATE_SHARED_SECRET=CHANGEME_LONG_RANDOM_SHARED_SECRET
# how long /c/<code> waits for the bot before falling back (ms)
GATE_BOT_TIMEOUT_MS=3000

# --- dashboard auth ---
ADMIN_USER=CHANGEME_ADMIN_USERNAME
ADMIN_PASS=CHANGEME_LONG_RANDOM_PASSWORD

# --- internal join auth (optional; when unset, loopback only) ---
JOIN_KEY=CHANGEME_SHARED_SECRET_FROM_GATE_BOTS

# --- nightly backup (docs/07 §6); on by default, BACKUP_DIR=off disables it ---
BACKUP_DIR=/var/backups/coinvoo
BACKUP_KEEP=14

# --- bot-DB snapshot (docs/07 §5), written by ops/sync-botdb.sh ---
BOTDB_SNAPSHOT=/srv/coinvoo/botdb-snapshot.db
SNAPSHOT_STALE_MINUTES=30

# --- existing databases (read-only) ---
# BOT_DB is read only by ops/sync-botdb.sh on the bot host (/etc/default/coinvoo-sync), never by the service
BOT_DB=/srv/trading-bot/trading-bot.db
GATE_DB_10X=/root/gatebot1-bot/gatebot1.db
GATE_DB_ECHO=/root/brand-two-onboard-bot/brand-two-onboard.db
RECON_DB=/srv/aff-recon/recon.db

# --- parallel run (phase 2) ---
PARALLEL_FORWARD=1
JOINVOO_PB=https://joinvoo.com/pb/CHANGEME_POSTBACK_TOKEN
PARK_HOURS=48
FORWARD_BACKOFF_MIN=1,2,4,8,15,30,60

# --- brand seeds (phase 1, used by migrations/002_seed_brands.sql) ---
BRAND_ONE_CODE=brand-one
BRAND_ONE_NAME=brand-one
BRAND_ONE_AFFILIATE_ID=CHANGEME_AFFILIATE_ID
BRAND_ONE_BOT_USERNAME=CHANGEME_GATE_BOT_USERNAME
BRAND_ONE_CHANNEL_ID=CHANGEME_TELEGRAM_CHANNEL_ID
BRAND_ONE_INVITE_LINK=CHANGEME_INVITE_LINK
BRAND_ONE_OFFER_TPL=https://CHANGEME_BROKER/lp/CHANGEME_PAGE/?aff=CHANGEME_AFFILIATE_ID&aff_model=revenue&afftrack={AFFTRACK}

BRAND_TWO_CODE=brand-two
BRAND_TWO_NAME=brand-two
BRAND_TWO_AFFILIATE_ID=CHANGEME_AFFILIATE_ID
BRAND_TWO_BOT_USERNAME=CHANGEME_GATE_BOT_USERNAME
BRAND_TWO_CHANNEL_ID=CHANGEME_TELEGRAM_CHANNEL_ID
BRAND_TWO_INVITE_LINK=CHANGEME_INVITE_LINK
BRAND_TWO_OFFER_TPL=https://CHANGEME_BROKER/lp/CHANGEME_PAGE/?aff=CHANGEME_AFFILIATE_ID&aff_model=revenue&afftrack={AFFTRACK}

# --- reporting (phase 5) ---
REPORT_BOT_TOKEN=CHANGEME_BOT_TOKEN_FOR_REPORTS_ONLY
REPORT_CHAT_ID=CHANGEME_TELEGRAM_CHAT_ID
ALERT_CHAT_ID=CHANGEME_TELEGRAM_CHAT_ID
REPORT_HOUR=8
POSTBACK_SILENCE_HOURS=6
PARKED_ALERT_PCT=50
# the parked alert needs at least this many decided events in 24 h
PARKED_ALERT_MIN_EVENTS=10
# Bot API base URL; only changed to aim the proof script at a local stand-in
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Meta Conversions API (phase 8) ---
# 0 = off: no rows queued, no network call, the token is never read. 1 = on (then dataset and token are required).
META_CAPI_ENABLED=0
META_DATASET_ID=CHANGEME_META_DATASET_ID
# system-user token for the Conversions API app; lives in this .env only, never in the repo or a log
META_CAPI_TOKEN=CHANGEME_META_CAPI_ACCESS_TOKEN
META_API_VERSION=v22.0
# set only while checking events in Events Manager > Test events; sent as test_event_code on every request
# META_TEST_EVENT_CODE=CHANGEME_TEST_EVENT_CODE
META_CAPI_TIMEOUT_MS=8000
META_CAPI_MAX_TRIES=5
# events per POST (1-1000); the worker sends one batch per tick
META_CAPI_BATCH=50
